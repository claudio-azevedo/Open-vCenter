---
// The cube mark from the logo (.github/ovc-logo.svg), without the wordmark so
// it stays crisp at small sizes. The faces follow the skin: --logo-top for the
// top face, the text colour for the rest (white on the dark/blue bars, dark on
// win9x).
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg viewBox="38 30 124 142" class:list={["logo-mark", className]} aria-hidden="true">
  <polygon points="100,36 156,68 100,100 44,68" fill="var(--logo-top)" />
  <polygon points="44,74 96,104 96,166 44,136" fill="currentColor" />
  <polygon
    points="108,108 152,82 152,132 108,158"
    fill="none"
    stroke="currentColor"
    stroke-width="7"
    stroke-linejoin="round"
  />
</svg>

<style>
  .logo-mark {
    --logo-top: #1e73be;
    color: var(--color-fg);
  }
  :global(:root[data-site-theme="win9x"]) .logo-mark {
    --logo-top: #00569d;
  }
  :global(:root:is([data-site-theme="xp"], [data-site-theme="win7"])) .logo-mark {
    --logo-top: #0d273e;
  }
</style>
