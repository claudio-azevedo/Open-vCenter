---
// Starlight override: the same logo and wordmark as the landing page header.
import LogoMark from "../LogoMark.astro";
---

<a href="/" class="flex min-w-0 items-center gap-2.5 no-underline" aria-label="Open vCenter home">
  <LogoMark class="h-7 w-auto shrink-0" />
  <span class="truncate text-[17px] font-semibold tracking-tight text-fg">
    Open <span class="text-gradient">vCenter</span>
  </span>
  <span class="ml-1 hidden rounded-md border border-line px-1.5 py-0.5 font-mono text-[11px] text-muted sm:inline">docs</span>
</a>
