{
  "realm": "ovc",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "client": {
      "ovc-frontend": [
        { "name": "ADMINISTRATOR", "description": "Full access to Open vCenter" },
        { "name": "MANAGE_VMS", "description": "Start/stop VMs within granted scope" },
        { "name": "VIEW_ONLY", "description": "Read-only access within granted scope" }
      ]
    }
  },
  "clients": [
    {
      "clientId": "ovc-frontend",
      "name": "Open vCenter (frontend)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ovc-frontend-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost/frontend-api/auth/callback/oidc",
        "http://localhost/*",
        "http://localhost:3000/frontend-api/auth/callback/oidc",
        "http://localhost:3000/*"
      ],
      "webOrigins": ["http://localhost", "http://localhost:3000"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost/*##http://localhost:3000/*"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "basic", "email"],
      "protocolMappers": [
        {
          "name": "audience-ovc-frontend",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ovc-frontend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "client-roles-ovc-frontend",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "ovc-frontend",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@ovc.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "OVC",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "clientRoles": { "ovc-frontend": ["ADMINISTRATOR"] }
    },
    {
      "username": "operator",
      "email": "operator@ovc.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "OVC",
      "lastName": "Operator",
      "credentials": [{ "type": "password", "value": "operator", "temporary": false }],
      "clientRoles": { "ovc-frontend": ["MANAGE_VMS"] }
    },
    {
      "username": "noroles",
      "email": "noroles@ovc.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "No",
      "lastName": "Roles",
      "credentials": [{ "type": "password", "value": "noroles", "temporary": false }],
      "clientRoles": {}
    }
  ]
}
